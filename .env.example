# ============================================================
#  StudyBuddy — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Database
# SQLite (default, good for local dev / small deployments)
DATABASE_URL=sqlite:///studybuddy.db

# PostgreSQL example (use on Render / Railway)
# DATABASE_URL=postgresql://user:password@host:5432/studybuddy

# -------------------------------------------------------
# LLM Provider — pick one and fill in the values
# -------------------------------------------------------

# --- Groq (fast, free tier available) ---
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama3-8b-8192

# --- OpenAI ---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# --- Together AI ---
# LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL_NAME=meta-llama/Llama-3-8b-chat-hf
